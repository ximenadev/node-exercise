NODE_ENV=development
PORT=3000

# <USERNAME> and <PASSWORD> in DB_URL are replaced with the two values below
DB_URL=mongodb+srv://<USERNAME>:<PASSWORD>@your-cluster.mongodb.net/your-database?retryWrites=true&w=majority
DB_USERNAME=
DB_PASSWORD=

# Generate a secret with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# Mailtrap sandbox for development
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=
EMAIL_PASSWORD=
