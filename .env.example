NODE_ENV=development
PORT=3000

# <USERNAME> and <PASSWORD> in DB_URL are replaced with DB_USERNAME and DB_PASSWORD
DB_URL=mongodb+srv://<USERNAME>:<PASSWORD>@your-cluster.mongodb.net/your-database?retryWrites=true&w=majority
DB_USERNAME=
DB_PASSWORD=

# Generate a secret with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Mailtrap sandbox for development
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=Your App <hello@example.com>
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_SECURE=false
SMTP_PASSWORD=
SMTP_FROM=Your App <hello@example.com>

# Public address of this API, used in password-reset links (no trailing slash)
BASE_URL=http://localhost:3000

# Optional: number of reverse proxies in front of the app (e.g. 1 on Render, Heroku or nginx).
# Leave it unset when the app is reached directly. Needed so rate limits count real client IPs.
# TRUST_PROXY=1

# Optional: origin(s) of the frontend allowed to call this API from a browser, comma-separated
# (scheme + host + port, no trailing slash). Leave it unset when the API and frontend share an origin.
# CLIENT_URL=http://localhost:5173
