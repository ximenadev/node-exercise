{
  "name": "natours",
  "version": "1.0.0",
  "description": "learning node express and mongoDB",
  "homepage": "https://github.com/ximenadev/node-course#readme",
  "bugs": {
    "url": "https://github.com/ximenadev/node-course/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximenadev/node-course.git"
  },
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsup server.ts --format esm --target node20 --out-dir dist",
    "start": "node dist/server.js",
    "dev": "NODE_ENV=development tsx watch server.ts",
    "debug": "NODE_ENV=development ndb tsx server.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "morgan": "^1.12.1",
    "slugify": "^1.6.9",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.2",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
